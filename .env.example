# Servidor (packages/server). Copie para .env e exporte as variáveis (ou use um gerenciador).
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SERVER_URL=http://localhost:2567
CLIENT_URL=http://localhost:5173
# Redirect URIs a cadastrar nos provedores:
#   http://localhost:2567/auth/google/callback
#   http://localhost:2567/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Conta convidada é liberada só fora de produção, a menos que ALLOW_GUEST=1
# ALLOW_GUEST=1

# Banco de dados (F2). Sem DATABASE_URL o servidor usa um PostgreSQL embutido (PGlite) em .data/ - só para desenvolvimento.
# Supabase: Connect > Session pooler (porta 5432). NUNCA commite este valor.
# DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Certificado raiz do banco (Supabase: Project Settings > Database > SSL Configuration). Recomendado em produção.
# DATABASE_CA=-----BEGIN CERTIFICATE-----...
